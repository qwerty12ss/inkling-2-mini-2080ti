ninja_required_version = 1.3
name = @NAME@
cuda_home = @CUDA@
cxx = @CXX@
nvcc = $cuda_home/bin/nvcc
cxx_launcher = 
nvcc_launcher = 

common_cflags = -DPy_LIMITED_API=0x03090000 $
    -D_GLIBCXX_USE_CXX11_ABI=1 $
    -I@SITE@/flashinfer/data/cccl/cub $
    -I@SITE@/flashinfer/data/cccl/libcudacxx/include $
    -I@SITE@/flashinfer/data/cccl/thrust $
    -isystem @PYINC@ $
    -isystem $cuda_home/include $
    -isystem @SITE@/tvm_ffi/include $
    -isystem @SITE@/tvm_ffi/include $
@EXTRA_INCLUDE@    -isystem @SITE@/flashinfer/data/csrc $
    -isystem @SITE@/flashinfer/data/cutlass/include $
    -isystem @SITE@/flashinfer/data/cutlass/tools/util/include $
    -isystem @SITE@/flashinfer/data/spdlog/include
cflags = $common_cflags $
    -fPIC $
    -std=c++17 $
    -Wno-switch-bool $
    -DNDEBUG $
    -O3
post_cflags =
cuda_cflags = $common_cflags $
    --compiler-options=-fPIC $
    --expt-relaxed-constexpr $
    -static-global-template-stub=false $
    -gencode=arch=compute_75,code=sm_75 $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -std=c++17 $
    --threads=1 $
    -use_fast_math $
    -Xfatbin=-compress-all $
    --compress-mode=size $
    -DFLASHINFER_ENABLE_F16 $
    -DFLASHINFER_ENABLE_BF16 $
    -DFLASHINFER_ENABLE_FP8_E4M3 $
    -DFLASHINFER_ENABLE_FP8_E5M2 $
    -DNDEBUG $
    -O3@EXTRA_NVCC@
cuda_post_cflags =
ldflags = -shared $
    -L$cuda_home/lib64 $
    -L$cuda_home/lib64/stubs $
    -lcudart $
    -lcuda

rule compile
  command = $cxx_launcher $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc_launcher $nvcc --generate-dependencies-with-compile -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $in $ldflags -o $out

build @OUT@/@NAME@_batch_prefill_paged_kernel_mask_0.cuda.o: cuda_compile @SOURCE@/batch_prefill_paged_kernel_mask_0.cu
build @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_0.cuda.o: cuda_compile @SOURCE@/batch_prefill_ragged_kernel_mask_0.cu
build @OUT@/@NAME@_batch_prefill_paged_kernel_mask_1.cuda.o: cuda_compile @SOURCE@/batch_prefill_paged_kernel_mask_1.cu
build @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_1.cuda.o: cuda_compile @SOURCE@/batch_prefill_ragged_kernel_mask_1.cu
build @OUT@/@NAME@_batch_prefill_paged_kernel_mask_2.cuda.o: cuda_compile @SOURCE@/batch_prefill_paged_kernel_mask_2.cu
build @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_2.cuda.o: cuda_compile @SOURCE@/batch_prefill_ragged_kernel_mask_2.cu
build @OUT@/@NAME@_batch_prefill_paged_kernel_mask_3.cuda.o: cuda_compile @SOURCE@/batch_prefill_paged_kernel_mask_3.cu
build @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_3.cuda.o: cuda_compile @SOURCE@/batch_prefill_ragged_kernel_mask_3.cu
build @OUT@/@NAME@_batch_prefill.cuda.o: cuda_compile @SOURCE@/batch_prefill.cu
build @OUT@/@NAME@_batch_prefill_jit_binding.cuda.o: cuda_compile @SOURCE@/batch_prefill_jit_binding.cu

build @OUT@/@NAME@.so: link @OUT@/@NAME@_batch_prefill_paged_kernel_mask_0.cuda.o @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_0.cuda.o @OUT@/@NAME@_batch_prefill_paged_kernel_mask_1.cuda.o @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_1.cuda.o @OUT@/@NAME@_batch_prefill_paged_kernel_mask_2.cuda.o @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_2.cuda.o @OUT@/@NAME@_batch_prefill_paged_kernel_mask_3.cuda.o @OUT@/@NAME@_batch_prefill_ragged_kernel_mask_3.cuda.o @OUT@/@NAME@_batch_prefill.cuda.o @OUT@/@NAME@_batch_prefill_jit_binding.cuda.o
default @OUT@/@NAME@.so
